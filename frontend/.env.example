VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_LOGIN=false
# Sales/CRM nav + routes. Enabled by default; set false only to hide the stack.
VITE_ENABLE_SALES=true
# Release lockdown: when unset (or anything but "false") the portal shows ONLY
# the self-service surface to every role except hr and ceo. ON by default so a
# production build locks itself without deploy-time configuration — see
# src/app/features.js. frontend/.env.development already sets it false, so a
# local `npm run dev` shows the full app; set it here only to override that.
VITE_SELF_SERVICE_ONLY=false

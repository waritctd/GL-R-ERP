# UAT-branch build-time frontend config (Vite loads this during `vite build`, mode=production).
#
# ⚠️ OVERLAY FILE — uat branch ONLY. Must NEVER be merged into `main`: it would enable the frozen
# sales/CRM stack on the demo/prod build. The `uat` branch is an overlay on top of `main`
# (uat = main + UAT-only infra: application-uat.yml, render.yaml uat service, db/migration-uat/*,
# vercel.json rewrite, and this file). Promote features to `main` via their own PRs; integrate the
# other direction only (merge `main` -> `uat`), never `uat` -> `main` wholesale.

# PHASE-1 UAT PREVIEW OVERRIDE (branch feat/uat-phase1-self-service only).
#
# `uat` sets this to `true` to expose the sales nav + routes for the seeded UAT sales data
# (db/migration-uat/V903 — tickets, commissions, deposit notices) for TKT-*/COM-* acceptance
# testing. This preview branch flips it to `false`: the phase-1 UAT round covers employee
# self-service and the employee dashboard only, so sales is out of scope for this round.
#
# SALES_ENABLED is an off-switch (see src/app/features.js), and App.jsx wraps the entire sales
# route block in `{SALES_ENABLED && ...}` while AppShell gates every sales nav item on it, so
# `false` here removes the routes as well as the menu entries.
#
# ⚠️ This line is why this branch must never be merged back into `uat`: it would disable sales for
# the whole UAT environment and break TKT-*/COM-* testing.
VITE_ENABLE_SALES=false

# Phase-1 landing-page scope (src/app/features.js). Deliberately an ON-switch — the opposite
# direction from VITE_ENABLE_SALES — so it stays off on `uat`, on `main`, and on every other
# preview; it is only ever set here. Routes hr -> HrOverview, division manager ->
# DivisionManagerOverview, everyone else with an employeeId -> EmployeeSelfService.
VITE_UAT_PHASE1=true

# Real backend + real Spring session — never the password-less mock quick-login (that path is gated
# on VITE_USE_MOCKS and must not ship to a hosted environment).
VITE_USE_MOCKS=false

# VITE_API_BASE_URL is intentionally left UNSET: the /api rewrite in vercel.json proxies to
# gl-r-erp-uat.onrender.com same-origin, which preserves the SameSite=Lax session cookie. Setting a
# base URL here would make requests cross-origin and drop the cookie on login.

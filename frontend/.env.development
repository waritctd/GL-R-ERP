# Development-server overlay. Vite loads this file for `vite`/`npm run dev`
# (mode=development) and NEVER for `vite build` (mode=production), so nothing
# here can reach a deployed bundle.
#
# `.env*` is gitignored repo-wide; this file is force-added on purpose
# (`git add -f frontend/.env.development`). It is the mechanism that keeps the
# development branch usable: SELF_SERVICE_ONLY defaults ON so that the
# production build locks itself with no deploy-time configuration — see
# frontend/src/app/features.js for why the default must be the locked one —
# and this turns it back off for local work, so `npm run dev` shows the whole
# app (sales/CRM, HR, payroll) for every role.
#
# The real-backend e2e suite starts its frontend with `npm run dev`
# (playwright.real.config.js), so it picks this up too and keeps testing the
# full surface.
#
# Do NOT add a matching frontend/.env.production. That file IS loaded by the
# production build, and an unlock there would ship the whole ERP to everyone.
VITE_SELF_SERVICE_ONLY=false

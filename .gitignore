node_modules/
dist/
.vite/
backend/target/
.DS_Store
*.timestamp-*.mjs
*.log
.env
.env.local
.env.*.local

# Python (attendance agent tooling)
.venv/
.venv*/
venv/
__pycache__/
*.pyc

# Dev-local Claude config (keep launch.json and the session-start hook shared with the team)
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**

# Local docker override (dev-only port/profile changes)
docker-compose.override.yml

# Generated PDFs (source of truth is the .md)
*.pdf
# ...except signed policy documents the app serves as in-product reference material.
# These are the inverse case: there is no .md behind them — the scanned, signed PDF IS
# the source of truth, and the UI links to it so an employee can read the rule the
# system enforced. Without this negation `git add` drops them silently.
!frontend/public/policy/*.pdf
# ...and except official government form templates the backend fills at runtime. Same inverse
# case again: forms/loryor01_290362.pdf IS the ล.ย.01 document, downloaded verbatim from
# rd.go.th, and LorYor01Renderer loads it off the classpath. Without this negation it stays a
# local-only file, every test passes on the machine that downloaded it, and the deployed app
# throws FileNotFoundException the first time an employee asks for their form.
!backend/src/main/resources/forms/*.pdf

# UAT/SIT operational deliverables — kept out of git (store externally)
ERP Documentation/SIT Deliverables/
ERP Documentation/UAT Deliverables/
ERP Documentation/13_SIT_Plan.md
ERP Documentation/14_UAT_Plan.md
ERP Documentation/15_GoLive_Transition_Plan.md
ERP Documentation/16_Post_UAT_Next_Steps.md

# AI-prompt-feeding bundle that concatenates 01-12 verbatim (regenerate on demand,
# don't commit — it's a duplicate of the numbered docs, not a separate source of truth)
ERP Documentation/00_ALL_DOCS_BUNDLE.md

# Automation tooling leftovers (e.g. Java-upgrade agent run artifacts)
.github/modernize/

# Vercel deploy artifacts
.vercel/
.vercel
.env*

# UX audit evidence — kept local only (large binaries; enable LFS before committing)
docs/ux-ui-audit/screenshots/

# Database snapshots taken before a destructive prod/UAT operation (row dumps kept
# locally as a rollback record). These contain real production rows — including
# employee and customer data — so they must never enter git history, where a delete
# does not remove them. The whole directory is ignored, not one filename: the next
# snapshot will be dated differently and would otherwise be exposed again.
# Keep such dumps outside the repo entirely where you can.
docs/agent-handoffs/backups/

# Playwright e2e (Stage K2) run artifacts
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/playwright/.cache/

# Real-backend e2e run artifacts (playwright.real.config.js keeps its own report/output dirs
# so a mock run and a real run never overwrite each other's results).
frontend/playwright-report-real/
frontend/test-results-real/
# Uploads the e2e backend writes when APP_UPLOADS_DIR is left at its default.
backend/target/e2e-uploads/

# Untracked design-review tooling output (impeccable skill) — not source
.impeccable/

# Generated UI captures and the retired design-audit corpus.
# This repository is PUBLIC: role-based captures cover payroll, employees,
# commissions and profile screens and must never be committed.
frontend/screenshots/
frontend/GL&R Design Audit/
frontend/UX Agents.md

# Visual-regression baselines (frontend/e2e-visual/visual-baseline.spec.js,
# opt-in via VISUAL_BASELINE=1 — see that file's header comment for usage).
# Large PNGs of payroll/employee/commission screens — this repository is
# PUBLIC, same reason frontend/screenshots/ is ignored above. Regenerate
# locally with `--update-snapshots` before each migration slice. (Restores
# the equivalent frontend/e2e/*.spec.js-snapshots/ entry PR #592 removed
# along with frontend/e2e/ itself; playwright.visual.config.js does not
# override the default report/output-dir names, so this suite's run
# artifacts are already covered by the "Playwright e2e (Stage K2)" block
# above rather than needing a dedicated entry here.)
frontend/e2e-visual/*.spec.js-snapshots/

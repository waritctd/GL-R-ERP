# Copy to ops/onprem/.env (gitignored) and fill in. Never commit real values.
# Variables marked "default ..." are commented out: leave them out of .env to keep application.yml's
# default — an EMPTY value overrides the default with blank.
# Compose interpolates "$" in this file: generate secrets with `openssl rand -hex 32`, or write a
# literal "$" as "$$".

# ── Required by docker-compose.yml ───────────────────────────────────────────
# Backend image tag in ghcr.io/waritctd/glr-hr-backend (e.g. the tag render.yaml pins).
GLR_IMAGE_TAG=
# Postgres password for the db container (long random string; used by db and backend).
DB_PASSWORD=
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → the production tunnel).
TUNNEL_TOKEN=
# Backend max heap (default 2g).
# BACKEND_HEAP=2g

# ── Backend (passed to the container by name) ────────────────────────────────
# CORS fallback origin; requests are same-origin via nginx.
APP_CORS_ALLOWED_ORIGINS=https://glr-hub.com
# Shared secret the attendance agent sends.
APP_ATTENDANCE_AGENT_TOKEN=
# Bank of Thailand FX API key.
BOT_FX_API_TOKEN=
# Bank of Thailand holiday API key (separate key; BOT rate-limits per token).
BOT_HOLIDAY_API_TOKEN=
# Mail transport.
APP_MAIL_PROVIDER=resend
# Resend API key.
APP_MAIL_RESEND_API_KEY=
# Verified sender address for the Resend domain.
APP_MAIL_FROM=
# Portal URL every email links back to.
APP_MAIL_APP_BASE_URL=https://glr-hub.com
# Optional monitored Reply-To mailbox (blank = no Reply-To header).
APP_MAIL_REPLY_TO=
# Month-end attendance email recipient (blank = off).
APP_ATTENDANCE_MONTHLY_REPORT_TO=
# Month-end attendance email CC list, comma-separated (blank = no CC).
APP_ATTENDANCE_MONTHLY_REPORT_CC=
# HR inbox for leave-submission emails (default in application.yml).
# APP_LEAVE_SUBMISSION_INBOX=
# Employee code allowed to use read-only view-as (blank = feature off).
GLR_VIEW_AS_OWNER_EMPLOYEE_CODE=

# ── Payroll employer constants (stamped into KBank / PND1 / SSO export files) ─
# The demo profile (application-demo.yml) sets these, and a profile file outranks the APP_PAYROLL_*
# placeholders in application.yml. These relaxed-binding names outrank the profile file. Leave them
# all commented out to keep the demo profile's values (same as Render today).
# Company name (Thai) as registered.
# APP_PAYROLL_EMPLOYER_COMPANYNAMETH=
# Company tax ID.
# APP_PAYROLL_EMPLOYER_COMPANYTAXID=
# SSO establishment name (blank = company name).
# APP_PAYROLL_EMPLOYER_ESTABLISHMENTNAME=
# KBank debit account for payroll transfers.
# APP_PAYROLL_EMPLOYER_KBANKDEBITACCOUNT=
# KBank batch reference.
# APP_PAYROLL_EMPLOYER_KBANKBATCHREF=
# SSO employer account number.
# APP_PAYROLL_EMPLOYER_SSOEMPLOYERACCOUNT=
# PND1 branch.
# APP_PAYROLL_EMPLOYER_PND1BRANCH=
# SSO branch.
# APP_PAYROLL_EMPLOYER_SSOBRANCH=
# SSO rate percent.
# APP_PAYROLL_EMPLOYER_SSORATEPERCENT=
# Default payroll transfer day of month.
# APP_PAYROLL_EMPLOYER_DEFAULTTRANSFERDAY=

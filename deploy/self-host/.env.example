# ─────────────────────────────────────────────────────────────────────────────
# GL-R-ERP self-host secrets & config.
#   cp .env.example .env  &&  chmod 600 .env  &&  edit
# NEVER commit .env (see .gitignore). Every __SET_ME__ must be filled before boot.
#
# Env var names are taken verbatim from the app (application.yml / application-prod.yml
# / render.yaml). Do not rename them.
# ─────────────────────────────────────────────────────────────────────────────

# Pinned backend image tag (carries the licensed Thai fonts). Match render.yaml's
# current image.url tag, or a newer one you built with build-push-backend-image.sh.
BACKEND_IMAGE_TAG=v2026-09-16c

# ── Database ─────────────────────────────────────────────────────────────────
# The postgres container is created with these; the backend connects with them.
SPRING_DATASOURCE_USERNAME=glr
# ⚠️ The password shared in chat should be considered exposed — generate a fresh
#    strong one here (e.g. `openssl rand -base64 24`) and use it for both.
SPRING_DATASOURCE_PASSWORD=__SET_ME__
# Topology-fixed; overridden in docker-compose too. Leave as-is.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hris

# ── Flyway (match REAL prod, not the Render showcase) ────────────────────────
APP_FLYWAY_ENABLED=true
# Stays false: real prod history has checksum drift + the V11 vs V11.1/V11.2 split.
# Flipping to true hard-fails the deploy. See application-prod.yml.
APP_FLYWAY_VALIDATE_ON_MIGRATE=false
# Do NOT add classpath:db/migration-demo here — that seeds demo logins into the real
# DB (the 2026-07-24 incident). Bare prod defaults to classpath:db/migration; leave unset.

# ── Uploads (REQUIRED — bare prod hard-fails on boot if blank) ───────────────
APP_UPLOADS_DIR=/srv/glr/uploads

# ── Web / session / CORS ─────────────────────────────────────────────────────
# Public domain. Same-origin via Caddy makes CORS a fallback, but set it anyway.
APP_CORS_ALLOWED_ORIGINS=https://erp.example.com
# Browser ↔ Cloudflare is HTTPS, so the session cookie stays Secure. Keep true.
SERVER_SESSION_COOKIE_SECURE=true

# ── Attendance kiosk/agent token (set if the punch agent is used) ────────────
APP_ATTENDANCE_AGENT_TOKEN=__SET_ME__

# ── Mail (REQUIRED when provider is resend/smtp — bare prod hard-fails otherwise)
# On this on-prem server outbound SMTP is NOT blocked (Render was), so smtp is the
# natural choice. Use provider=log only to defer mail entirely (no real sends).
APP_MAIL_PROVIDER=smtp
APP_MAIL_FROM=noreply@example.com
APP_MAIL_APP_BASE_URL=https://erp.example.com
# provider=smtp:
APP_MAIL_SMTP_HOST=__SET_ME__
APP_MAIL_SMTP_PORT=587
APP_MAIL_SMTP_USERNAME=__SET_ME__
APP_MAIL_SMTP_PASSWORD=__SET_ME__
APP_MAIL_SMTP_STARTTLS=true
# provider=resend (alternative — uncomment and set provider=resend above):
# APP_MAIL_RESEND_API_KEY=__SET_ME__
# Optional, improves deliverability if it resolves to a real monitored mailbox:
# APP_MAIL_REPLY_TO=support@example.com

# ── BOT data feeds (optional; warn-only if blank) ────────────────────────────
BOT_FX_API_TOKEN=
BOT_HOLIDAY_API_TOKEN=

# ── Payroll employer identity (warn-only if blank, but payslips need them) ───
# APP_PAYROLL_COMPANY_NAME_TH=
# APP_PAYROLL_COMPANY_TAX_ID=
# APP_PAYROLL_KBANK_DEBIT_ACCOUNT=
# APP_PAYROLL_SSO_EMPLOYER_ACCOUNT=

# ── Cloudflare Tunnel token (Zero Trust dashboard → Tunnels → your tunnel) ───
CLOUDFLARE_TUNNEL_TOKEN=__SET_ME__

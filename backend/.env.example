SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-POSTGRES-HOST:5432/hris
SPRING_DATASOURCE_USERNAME=YOUR_APP_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_APP_DB_PASSWORD
APP_FLYWAY_ENABLED=true
APP_UPLOADS_DIR=/var/lib/glr-hr/uploads
APP_CORS_ALLOWED_ORIGINS=https://erp.example.local
SERVER_SESSION_COOKIE_SECURE=true
APP_ATTENDANCE_AGENT_TOKEN=
# Notification email: transport is pluggable behind th.co.glr.hr.mail.Mailer (app.mail.provider).
# `resend` = Resend HTTP API (use on hosts that block outbound SMTP, e.g. Render). `smtp` =
# authenticated SMTP as APP_MAIL_FROM (on-prem). `log` (default) = logs instead of sending.
APP_MAIL_PROVIDER=log
# REQUIRED (at boot, under the prod profile) when APP_MAIL_PROVIDER is resend or smtp — see
# ProductionReadinessConfig. Never defaults to a real sender.
APP_MAIL_FROM=
# REQUIRED (at boot, under the prod profile) when APP_MAIL_PROVIDER is resend or smtp — every
# notification/payslip email links back to this URL. Never defaults to a real deployment's host.
APP_MAIL_APP_BASE_URL=
# REQUIRED (at boot, under the prod profile) when APP_MAIL_PROVIDER=resend.
APP_MAIL_RESEND_API_KEY=
# provider=smtp only:
APP_MAIL_SMTP_HOST=
APP_MAIL_SMTP_PORT=587
APP_MAIL_SMTP_USERNAME=
APP_MAIL_SMTP_PASSWORD=
# Optional on every provider. Leave blank in production — see application.yml's comments.
APP_MAIL_REPLY_TO=
APP_MAIL_OVERRIDE_TO=
APP_MAIL_SUBJECT_SUFFIX=
